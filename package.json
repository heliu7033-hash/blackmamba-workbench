{
  "name": "blackmamba-workbench",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:local",
    "build:local": "node scripts/build-local.mjs",
    "test": "node scripts/run-tests.mjs",
    "db:generate": "drizzle-kit generate",
    "build:cloud": "node scripts/build.mjs",
    "build:mac": "bash desktop/build.sh",
    "test:mcp": "node scripts/test-mcp.mjs",
    "start": "node server.mjs",
    "desktop:prepare": "node scripts/prepare-electron.mjs",
    "desktop:dev": "npm run desktop:prepare && electron build/electron-app",
    "build:win": "npm run desktop:prepare && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "license": "MIT",
  "description": "Local-first creative and video production workbench",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heliu7033-hash/blackmamba-workbench.git"
  },
  "version": "0.1.1"
}
